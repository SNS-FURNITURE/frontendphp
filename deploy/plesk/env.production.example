APP_NAME="SNS Furniture"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN.COM

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# --- Database: Aiven OR a Plesk MySQL database (one of your 10 DBs) ---
DB_CONNECTION=mysql
DB_HOST=sns-db-new-sns-db.i.aivencloud.com
DB_PORT=26825
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=
DB_SSL=true
DB_SSL_VERIFY=false
# DB_URL="mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb"

# Plesk local MySQL example (alternative to Aiven):
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=your_plesk_db
# DB_USERNAME=your_plesk_db_user
# DB_PASSWORD=
# DB_SSL=false

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=sync
CACHE_STORE=database

TRUSTED_PROXIES=*
FORCE_HTTPS=true
API_RATE_LIMIT=120

# Use Plesk mailbox / SMTP (90 email accounts on plan)
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@YOUR-DOMAIN.COM"
MAIL_FROM_NAME="${APP_NAME}"

JWT_SECRET=
CORS_ALLOWED_ORIGINS=https://YOUR-DOMAIN.COM
SESSION_MAX_AGE_MS=86400000
REMEMBER_SESSION_MAX_AGE_MS=2592000000
INVOICE_LAUNCH_ENABLED=false
