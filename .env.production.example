APP_NAME="SNS Furniture"
APP_ENV=production
APP_KEY=base64:3uJm/EId3wG5w/yD1b0V49P2QZ0K1l2M3N4O5P6Q7R8=
APP_DEBUG=false
APP_URL=https://yourdomain.et

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Ethiotelecom MySQL Database Settings (created in Plesk > Databases)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_plesk_database_name
DB_USERNAME=your_plesk_database_user
DB_PASSWORD=your_plesk_database_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=lin6.ethiotelecom.et
MAIL_PORT=587
MAIL_USERNAME=info@yourdomain.et
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@yourdomain.et"
MAIL_FROM_NAME="${APP_NAME}"

# Must match your JWT secret if communicating with backend services (min 32 chars)
JWT_SECRET=sns-production-jwt-secret-key-32chars-min-change-this
CORS_ALLOWED_ORIGINS=https://yourdomain.et
SESSION_MAX_AGE_MS=86400000
REMEMBER_SESSION_MAX_AGE_MS=2592000000
INVOICE_LAUNCH_ENABLED=false
