APP_NAME="SNS Furniture"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# =============================================================================
# Database — switch providers by editing ONLY this block (then: php artisan config:clear)
# Fresh empty DB: php artisan migrate --seed
# Existing shared ERP DB that already has tables: migrate only new host tables
#   (sessions/cache) or run full migrate on empty Aiven.
# Prefer discrete DB_* vars OR a single DB_URL (URL wins when set).
# =============================================================================

DB_CONNECTION=mysql

# --- Profile A: Local MySQL (active by default) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sns_erp_db
DB_USERNAME=root
DB_PASSWORD=
DB_SSL=false
# MYSQL_ATTR_SSL_CA=
# DB_SSL_VERIFY=true
# DB_URL=

# --- Profile B: Aiven MySQL (comment Profile A, uncomment these) ---
# DB_HOST=xxxxx.a.aivencloud.com
# DB_PORT=12345
# DB_DATABASE=defaultdb
# DB_USERNAME=avnadmin
# DB_PASSWORD=your-aiven-password
# DB_SSL=true
# MYSQL_ATTR_SSL_CA="C:/path/to/ca.pem"
# DB_SSL_VERIFY=true
# DB_URL="mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb"

# --- Profile C: Any other MySQL / MariaDB / Postgres ---
# DB_CONNECTION=mysql
# DB_HOST=
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSL=true
# DB_URL=

# =============================================================================
# Sessions / cache / queue (production-ready defaults)
# After deploy: php artisan migrate --force  (creates sessions + cache tables)
# Then: composer run optimize
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Behind reverse proxies (Railway, Render, Cloudflare, Nginx): keep *
TRUSTED_PROXIES=*
# FORCE_HTTPS=true is implied when APP_ENV=production
FORCE_HTTPS=false
API_RATE_LIMIT=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Must match sns-erp-backend JWT_SECRET for token interoperability (min 32 chars for HS256).
JWT_SECRET=sns-local-dev-jwt-secret-key-32chars-min
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
SESSION_MAX_AGE_MS=86400000
REMEMBER_SESSION_MAX_AGE_MS=2592000000
INVOICE_LAUNCH_ENABLED=false

# =============================================================================
# Production checklist (hosting) — never commit real secrets
# Plesk Linux Platinum step-by-step: deploy/plesk/HOSTING.md
# Env template for Plesk: deploy/plesk/env.production.example
# Post-upload script (SSH): bash deploy/plesk/post-deploy.sh
# =============================================================================
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.example
# LOG_LEVEL=error
# FORCE_HTTPS=true
# SESSION_SECURE_COOKIE=true
# DB_SSL=true
# CORS_ALLOWED_ORIGINS=https://your-domain.example
# JWT_SECRET=<long-random-secret>
