APP_NAME="SNS ERP Laravel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Point at the EXISTING ERP MySQL database. Do not run php artisan migrate.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sns_erp_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=30
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Must match sns-erp-backend JWT_SECRET for token interoperability (min 32 chars for HS256).
JWT_SECRET=sns-local-dev-jwt-secret-key-32chars-min
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
SESSION_MAX_AGE_MS=86400000
REMEMBER_SESSION_MAX_AGE_MS=2592000000
INVOICE_LAUNCH_ENABLED=true
