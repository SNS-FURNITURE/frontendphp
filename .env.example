APP_NAME="SNS Furniture"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# =============================================================================
# Database — switch providers by editing ONLY this block (then: php artisan config:clear)
# Fresh empty DB: php artisan migrate --seed
# Existing shared ERP DB that already has tables: do NOT migrate.
#
# Prefer either discrete DB_* vars OR a single DB_URL (URL wins when set).
# =============================================================================

DB_CONNECTION=mysql

# --- Profile A: Local MySQL (active by default) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sns_erp_db
DB_USERNAME=root
DB_PASSWORD=
DB_SSL=false
# MYSQL_ATTR_SSL_CA=
# DB_SSL_VERIFY=true
# DB_URL=

# --- Profile B: Aiven MySQL (comment Profile A, uncomment these) ---
# DB_HOST=xxxxx.a.aivencloud.com
# DB_PORT=12345
# DB_DATABASE=defaultdb
# DB_USERNAME=avnadmin
# DB_PASSWORD=your-aiven-password
# DB_SSL=true
# Optional: download CA from Aiven console and set path
# MYSQL_ATTR_SSL_CA="C:/path/to/ca.pem"
# DB_SSL_VERIFY=true
# Or paste the Aiven connection URI instead of host/user/pass:
# DB_URL="mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb"

# --- Profile C: Any other MySQL / MariaDB / Postgres ---
# DB_CONNECTION=mysql
# DB_HOST=
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSL=true
# DB_URL=
# Postgres example:
# DB_CONNECTION=pgsql
# DB_PORT=5432
# DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=30
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Must match sns-erp-backend JWT_SECRET for token interoperability (min 32 chars for HS256).
JWT_SECRET=sns-local-dev-jwt-secret-key-32chars-min
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
SESSION_MAX_AGE_MS=86400000
REMEMBER_SESSION_MAX_AGE_MS=2592000000
# false = full product unlocked for all active roles; true = five launch roles only
INVOICE_LAUNCH_ENABLED=false
